* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

*.php linguist-language=PHP
*.blade.php linguist-language=PHP

*.css linguist-language=CSS
*.js linguist-language=JavaScript

# Third-party dependencies, including the bundled frontend libraries.
/node_modules/** linguist-vendored=true
/vendor/** linguist-vendored=true
/public/assets/extensions/** linguist-vendored=true
/resources/views/assets/extensions/** linguist-vendored=true

# Compiled assets and source maps do not represent application source code.
/public/build/** linguist-generated=true
/public/assets/compiled/** linguist-generated=true
/resources/views/assets/compiled/** linguist-generated=true
*.map linguist-generated=true

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
